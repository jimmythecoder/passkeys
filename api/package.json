{
    "name": "@passkeys/api",
    "displayName": "Passkey API Server",
    "private": true,
    "version": "1.0.0",
    "description": "Fastify / express server to handle webauthn registration and authentication",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=development tsx watch src/index.ts",
        "build:tsc": "tsc && tsc-alias",
        "build:cjs": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.cjs",
        "build": "node build.js",
        "genkey": "tsx utils/genkey.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-ssm": "^3.744.0",
        "@fastify/aws-lambda": "^5.1.4",
        "@fastify/cookie": "^11.0.2",
        "@fastify/helmet": "^13.0.1",
        "@fastify/multipart": "^9.0.3",
        "@passkeys/config": "workspace:^",
        "@passkeys/data-transfer-objects": "workspace:^",
        "@passkeys/exceptions": "workspace:^",
        "@passkeys/types": "workspace:^",
        "@simplewebauthn/server": "^13.1.1",
        "@types/aws-lambda": "^8.10.147",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/dotenv-webpack": "^7.0.8",
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.1",
        "@types/webpack": "^5.28.5",
        "aws-lambda": "^1.0.7",
        "aws-sdk": "^2.1692.0",
        "body-parser": "^1.20.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "dotenv-webpack": "^8.1.0",
        "dynamoose": "^4.0.3",
        "esbuild": "^0.24.2",
        "esbuild-plugin-fileloc": "^0.0.6",
        "express": "^4.21.2",
        "fastify": "^5.2.1",
        "fastify-plugin": "^5.0.1",
        "helmet": "^8.0.0",
        "jose": "^5.9.6",
        "json-schema-to-ts": "^3.1.1",
        "multer": "1.4.5-lts.1",
        "serverless-esbuild": "^1.54.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    },
    "devDependencies": {
        "@swc/core": "^1.10.14",
        "tsc-alias": "^1.8.10"
    }
}
